{
  "manifest_version": 3,
  "name": "Manga AutoScroll",
  "version": "1.0.0",
  "description": "Hands-free smooth scrolling for manga, webtoons and PDFs. Adjustable speed, keyboard shortcuts, floating controls — works even in Chrome's built-in PDF viewer.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Manga AutoScroll",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage", "scripting", "debugger", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-scroll": {
      "suggested_key": { "default": "Alt+S" },
      "description": "Start / pause auto-scroll"
    },
    "speed-up": {
      "suggested_key": { "default": "Alt+Up" },
      "description": "Scroll faster"
    },
    "speed-down": {
      "suggested_key": { "default": "Alt+Down" },
      "description": "Scroll slower"
    }
  }
}
